# 기본 실행: 외부 API 키 없이 로컬 Ollama 사용
LLM_BACKEND=ollama
SUPERVISOR_VERSION=v2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FAST_MODEL=qwen3.5:2b
OLLAMA_QUALITY_MODEL=qwen3.5:2b
OLLAMA_MAX_TOKENS=900

# 추적은 기본 해제. 필요할 때 본인의 설정으로 사용
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_PROJECT=skala-ai-mini-project
LANGCHAIN_API_KEY=

# 선택 사항: OpenAI 모드는 외부 API 비용 발생. 이번 실측에서는 사용하지 않음
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_QUALITY_MODEL=gpt-4o
